DATABASE_URL=postgres://USER@localhost:5432/favourland
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# PayPal – developer.paypal.com → Apps & Credentials (use Sandbox keys until launch)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Email (optional locally – without it emails are printed to the terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@favourbooksandmusic.com
# Gets a copy of every order and mentorship application
SHOP_NOTIFY_EMAIL=support@favourbooksandmusic.com

# Vercel Blob (set automatically when a Blob store is connected to the Vercel project)
BLOB_READ_WRITE_TOKEN=
# Random string; hides the folder ebook/music files are stored in
DOWNLOADS_SECRET_PREFIX=
